{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PlafondS3",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::galerie-*",
        "arn:aws:s3:::galerie-*/*"
      ]
    },
    {
      "Sid": "PlafondSQS",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueUrl",
        "sqs:GetQueueAttributes",
        "sqs:SendMessage",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage"
      ],
      "Resource": "arn:aws:sqs:eu-west-3:*:file-*"
    }
  ]
}
