{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LectureEtOutils",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:Get*",
        "iam:ListUsers",
        "iam:ListGroups",
        "iam:ListRoles",
        "iam:ListPolicies",
        "iam:ListInstanceProfiles",
        "iam:ListAccountAliases",
        "iam:GetAccountSummary",
        "iam:GetAccountPasswordPolicy",
        "iam:SimulateCustomPolicy",
        "iam:GetContextKeysForCustomPolicy",
        "iam:GetServiceLastAccessedDetails",
        "access-analyzer:ValidatePolicy",
        "access-analyzer:ListAnalyzers",
        "access-analyzer:ListPolicyGenerations",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:GetAccountPublicAccessBlock",
        "sqs:ListQueues",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "health:Describe*",
        "pricing:*",
        "cloudshell:*",
        "kms:ListAliases",
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LireMesIdentites",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*",
        "iam:SimulatePrincipalPolicy",
        "iam:GetContextKeysForPrincipalPolicy",
        "iam:GenerateServiceLastAccessedDetails"
      ],
      "Resource": [
        "arn:aws:iam::*:user/${aws:username}",
        "arn:aws:iam::*:user/stagiaire-${aws:username}",
        "arn:aws:iam::*:group/stagiaires-${aws:username}",
        "arn:aws:iam::*:role/role-galerie-${aws:username}",
        "arn:aws:iam::*:instance-profile/role-galerie-${aws:username}",
        "arn:aws:iam::*:policy/lecture-ec2-${aws:username}",
        "arn:aws:iam::*:policy/galerie-s3-${aws:username}"
      ]
    },
    {
      "Sid": "LireLesStrategiesCommunes",
      "Effect": "Allow",
      "Action": ["iam:GetPolicy", "iam:GetPolicyVersion", "iam:ListPolicyVersions"],
      "Resource": ["arn:aws:iam::aws:policy/*", "arn:aws:iam::*:policy/aws-cours-*"]
    },
    {
      "Sid": "MonMotDePasse",
      "Effect": "Allow",
      "Action": "iam:ChangePassword",
      "Resource": "arn:aws:iam::*:user/${aws:username}"
    },
    {
      "Sid": "EC2AParis",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:ModifySecurityGroupRules",
        "ec2:UpdateSecurityGroupRuleDescriptions*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {"aws:RequestedRegion": "eu-west-3"}
      }
    },
    {
      "Sid": "MaPaireDeCles",
      "Effect": "Allow",
      "Action": ["ec2:CreateKeyPair", "ec2:ImportKeyPair", "ec2:DeleteKeyPair"],
      "Resource": "arn:aws:ec2:eu-west-3:*:key-pair/cle-${aws:username}"
    },
    {
      "Sid": "TagsALaCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-3",
          "ec2:CreateAction": ["RunInstances", "CreateSecurityGroup", "CreateKeyPair", "ImportKeyPair"]
        }
      }
    },
    {
      "Sid": "MesInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:TerminateInstances",
        "ec2:ModifyInstanceMetadataOptions",
        "ec2:AssociateIamInstanceProfile",
        "ec2:ReplaceIamInstanceProfileAssociation",
        "ec2:DisassociateIamInstanceProfile"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {"aws:RequestedRegion": "eu-west-3"},
        "StringEqualsIgnoreCase": {"aws:ResourceTag/Proprietaire": "${aws:username}"}
      }
    },
    {
      "Sid": "MesStrategies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::*:policy/lecture-ec2-${aws:username}",
        "arn:aws:iam::*:policy/galerie-s3-${aws:username}"
      ]
    },
    {
      "Sid": "MonGroupeDeStagiaires",
      "Effect": "Allow",
      "Action": [
        "iam:CreateGroup",
        "iam:DeleteGroup",
        "iam:AddUserToGroup",
        "iam:RemoveUserFromGroup",
        "iam:AttachGroupPolicy",
        "iam:DetachGroupPolicy",
        "iam:PutGroupPolicy",
        "iam:DeleteGroupPolicy"
      ],
      "Resource": "arn:aws:iam::*:group/stagiaires-${aws:username}"
    },
    {
      "Sid": "StagiaireAvecSaLimite",
      "Effect": "Allow",
      "Action": ["iam:CreateUser", "iam:PutUserPermissionsBoundary"],
      "Resource": "arn:aws:iam::*:user/stagiaire-${aws:username}",
      "Condition": {
        "ArnLike": {"iam:PermissionsBoundary": "arn:aws:iam::*:policy/aws-cours-limite-stagiaire"}
      }
    },
    {
      "Sid": "GererLeStagiaire",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteUser",
        "iam:CreateLoginProfile",
        "iam:UpdateLoginProfile",
        "iam:DeleteLoginProfile",
        "iam:TagUser",
        "iam:UntagUser"
      ],
      "Resource": "arn:aws:iam::*:user/stagiaire-${aws:username}"
    },
    {
      "Sid": "RoleAvecSaLimite",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:PutRolePermissionsBoundary"],
      "Resource": "arn:aws:iam::*:role/role-galerie-${aws:username}",
      "Condition": {
        "ArnLike": {"iam:PermissionsBoundary": "arn:aws:iam::*:policy/aws-cours-limite-role"}
      }
    },
    {
      "Sid": "GererLeRole",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PassRole",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::*:role/role-galerie-${aws:username}",
        "arn:aws:iam::*:instance-profile/role-galerie-${aws:username}"
      ]
    },
    {
      "Sid": "MesBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::galerie-${aws:username}-*",
        "arn:aws:s3:::galerie-${aws:username}-*/*"
      ]
    },
    {
      "Sid": "MaFile",
      "Effect": "Allow",
      "Action": "sqs:*",
      "Resource": "arn:aws:sqs:eu-west-3:*:file-${aws:username}"
    }
  ]
}
