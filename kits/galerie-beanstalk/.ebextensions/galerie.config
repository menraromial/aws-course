# Réglages lus par Elastic Beanstalk au déploiement. L'assistant de la console
# peut les remplacer : l'énoncé demande de choisir les mêmes valeurs.
option_settings:
  aws:autoscaling:launchconfiguration:
    # IMDSv2 obligatoire, comme sur les instances des TP. Ce réglage fait aussi
    # utiliser un modèle de lancement, seul possible sur un compte récent.
    DisableIMDSv1: true
    RootVolumeType: gp3
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /sante
